{
  "expo": {
    "name": "RabahTec",
    "slug": "RabahTec2",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.rabahtec.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "لتسجيل الرسائل الصوتية والبث المباشر"
      }
    },
    "android": {
      "package": "com.rabahtec.app",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#080C16"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#080C16",
          "imageWidth": 200
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "يحتاج التطبيق الوصول للكاميرا من أجل البث المباشر",
          "microphonePermission": "يحتاج التطبيق الوصول للمايكروفون من أجل البث المباشر والرسائل الصوتية"
        }
      ]
    ]
  }
}
